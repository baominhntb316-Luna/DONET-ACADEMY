{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chạy Web DONET Academy (.NET Core)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/DONET_Academy.Web/bin/Debug/net10.0/DONET_Academy.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/DONET_Academy.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/DONET_Academy.Web/Views"
            }
        },
        {
            "name": "Mở Trình Duyệt Chrome (localhost:5128)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5128",
            "webRoot": "${workspaceFolder}/DONET_Academy.Web"
        }
    ]
}
