@model DONET_Academy.Core.Entities.LichRanhGiaoVien
@{
    ViewData["Title"] = "Xác nhận đặt lịch gia sư";
}

<div class="container py-5" style="max-width: 640px;">
    <div class="card-donet">
        <h3 class="fw-bold mb-3">Xác Nhận Đặt Ca Học 1-1</h3>
        <p class="text-muted small mb-4">Vui lòng kiểm tra kỹ thông tin thời gian và chính sách tạm giữ tiền trước khi thanh toán.</p>

        <div class="card bg-light p-3 border-0 rounded-3 mb-4">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Môn học:</span>
                <strong class="text-dark">@Model.MonHoc?.TenMonHoc</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Giáo viên hướng dẫn:</span>
                <strong class="text-dark">@Model.HoSoGiaoVien?.NguoiDung?.HoTen</strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Thời gian:</span>
                <strong class="text-dark">@Model.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @Model.ThoiGianKetThuc.ToString("HH:mm")</strong>
            </div>
            <div class="d-flex justify-content-between pt-2 border-top">
                <span class="text-muted">Học phí ca học:</span>
                <strong class="text-danger fs-5">@Model.GiaTien.ToString("N0") đ</strong>
            </div>
        </div>

        <div class="alert alert-warning small mb-4">
            <strong>Chính sách Escrow & Hoàn tiền (UML):</strong>
            <ul class="mb-0 mt-1 ps-3">
                <li>Số tiền @Model.GiaTien.ToString("N0") đ sẽ được chuyển vào <strong>Khoản tạm giữ (KhoanTamGiu)</strong>.</li>
                <li>Tiền chỉ quyết toán chuyển cho giáo viên sau khi buổi học hoàn thành nghiệm thu.</li>
                <li><strong>Hủy trước 48 giờ:</strong> Hoàn 100% tiền vào ví học sinh.</li>
                <li><strong>Hủy sau 48 giờ:</strong> Không hoàn tiền (quyết toán bù đắp cho giáo viên).</li>
            </ul>
        </div>

        <div class="d-flex gap-3">
            <a href="/Student/Tutors" class="btn-outline-donet flex-grow-1 text-center">Quay lại</a>
            <button onclick="showToast('Đặt lịch thành công! Số tiền đã được chuyển vào Khoản tạm giữ.', 'success'); setTimeout(() => window.location.href='/Student/Dashboard', 1200);" class="btn-donet flex-grow-1">Xác Nhận Đặt Lịch</button>
        </div>
    </div>
</div>

