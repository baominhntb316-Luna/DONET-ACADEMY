@{
    Layout = null;
    ViewData["Title"] = "Đăng Nhập Quản Trị Hệ Thống - DONET ACADEMY";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #1A1A1E 0%, #2A2826 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
            margin: 0;
            padding: 20px;
            color: #FFFFFF;
        }
        .admin-login-card {
            background: rgba(36, 35, 38, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(252, 183, 18, 0.25);
            border-radius: 24px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(250, 126, 10, 0.15);
            width: 100%;
            max-width: 440px;
            padding: 40px;
            position: relative;
            overflow: hidden;
            animation: appleSpringIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .admin-login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #FCB712, #FA7E0A);
        }
        .input-admin {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #FFFFFF;
            border-radius: 12px;
            padding: 12px 16px;
            transition: all 0.2s ease;
        }
        .input-admin:focus {
            background: rgba(255, 255, 255, 0.12);
            border-color: #FCB712;
            color: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(252, 183, 18, 0.25);
            outline: none;
        }
        .btn-admin-login {
            background: linear-gradient(135deg, #FCB712 0%, #FA7E0A 100%);
            border: none;
            color: #FFFFFF;
            font-weight: 700;
            padding: 14px;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(250, 126, 10, 0.4);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .btn-admin-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(250, 126, 10, 0.5);
            color: #FFFFFF;
        }
        .btn-admin-login:active {
            transform: scale(0.97);
        }
        .brand-admin-logo {
            filter: drop-shadow(0 4px 12px rgba(252, 183, 18, 0.3));
        }
    </style>
</head>
<body>
    <div class="admin-login-card">
        <!-- Brand Header -->
        <div class="text-center mb-4">
            <a href="/" class="d-inline-block mb-3">
                <img src="~/images/donet_logo.png" alt="DONET Academy" height="52" class="brand-admin-logo" />
            </a>
            <h4 class="fw-bold mb-1 text-white">TRUNG TÂM QUẢN TRỊ</h4>
            <p class="small text-white-50 mb-0">Hệ Thống Phân Quyền & Quản Lý Giáo Dục Đa Môn</p>
        </div>

        <!-- Form Login -->
        <form method="post" action="/Admin/Account/Login">
            <div class="mb-3">
                <label class="form-label small fw-bold text-white-50">Tài Khoản Quản Trị (Admin ID / Email)</label>
                <input type="text" name="username" class="form-control input-admin" value="admin@donet.edu.vn" required />
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label small fw-bold text-white-50 mb-0">Mật Khẩu Bảo Mật</label>
                    <span class="badge bg-warning text-dark py-1 px-2 small">Demo Token</span>
                </div>
                <input type="password" name="password" class="form-control input-admin" value="Admin@2026" required />
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="adminRemember" checked>
                    <label class="form-check-label small text-white-50" for="adminRemember">
                        Ghi nhớ phiên quản trị
                    </label>
                </div>
                <span class="small text-warning">2FA Active</span>
            </div>

            <button type="submit" class="btn btn-admin-login w-100 fs-6">
                Xác Thực & Vào Quản Trị Hệ Thống
            </button>
        </form>

        <div class="mt-4 pt-3 border-top border-secondary text-center">
            <a href="/" class="small text-white-50 text-decoration-none">
                ← Quay lại Cổng Người Dùng (Học Sinh & Giáo Viên)
            </a>
        </div>
    </div>
</body>
</html>

