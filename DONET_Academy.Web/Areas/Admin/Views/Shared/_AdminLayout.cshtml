@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị DONET ACADEMY</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <style>
        .admin-navbar {
            background: #1C1917;
            border-bottom: 2px solid #FCB712;
            padding: 10px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .admin-nav-item .nav-link {
            color: #E6DDCF;
            border-radius: var(--radius-full);
            padding: 8px 18px;
            font-size: 0.92rem;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .admin-nav-item .nav-link:hover {
            background: rgba(252, 183, 18, 0.15);
            color: #FCB712;
            transform: translateY(-1px);
        }
        .admin-nav-item .nav-link.active {
            background: linear-gradient(135deg, #FCB712 0%, #FA7E0A 100%);
            color: #FFFFFF !important;
            font-weight: 700;
            box-shadow: 0 4px 14px rgba(250, 126, 10, 0.4);
        }
        .admin-footer {
            background: #1C1917;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: #A8A29E;
            padding: 30px 0 20px;
            margin-top: 60px;
        }
    </style>
</head>
<body class="bg-body-tertiary">
    <header>
        <nav class="navbar navbar-expand-lg admin-navbar">
            <div class="container-fluid px-lg-5">
                <!-- Brand Official Lockup with Admin Badge -->
                <a class="navbar-brand d-flex align-items-center gap-2 me-4" href="/Admin/Dashboard">
                    <img src="~/images/donet_logo.png" alt="DONET ACADEMY" height="42" />
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1 ms-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                        ADMIN PORTAL
                    </span>
                </a>

                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar" aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">
                    <!-- Navigation Links Admin -->
                    <ul class="navbar-nav me-auto align-items-lg-center gap-1">
                        <li class="nav-item admin-nav-item">
                            <a class="nav-link fw-semibold @(currentController == "Dashboard" ? "active" : "")" href="/Admin/Dashboard">
                                Tổng Quan
                            </a>
                        </li>
                        <li class="nav-item admin-nav-item">
                            <a class="nav-link fw-semibold @(currentController == "Users" ? "active" : "")" href="/Admin/Users">
                                Người Dùng & Quyền
                            </a>
                        </li>
                        <li class="nav-item admin-nav-item">
                            <a class="nav-link fw-semibold @(currentController == "TeacherVerifications" ? "active" : "")" href="/Admin/TeacherVerifications">
                                Duyệt Hồ Sơ GV
                            </a>
                        </li>
                        <li class="nav-item admin-nav-item">
                            <a class="nav-link fw-semibold @(currentController == "Payouts" ? "active" : "")" href="/Admin/Payouts">
                                Duyệt Rút Tiền
                            </a>
                        </li>
                        <li class="nav-item admin-nav-item">
                            <a class="nav-link fw-semibold @(currentController == "Settings" ? "active" : "")" href="/Admin/Settings">
                                Cấu Hình Hệ Thống
                            </a>
                        </li>
                    </ul>

                    <!-- Admin User Bar -->
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-success-subtle text-success border border-success-subtle d-none d-xl-inline-block px-3 py-2 rounded-pill">
                            🟢 Phiên Làm Việc: Bảo Mật SSL
                        </span>

                        <a href="/" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-semibold small" target="_blank" title="Mở cổng học sinh/giáo viên trong tab mới">
                            Xem Cổng Người Dùng ↗
                        </a>

                        <div class="dropdown">
                            <button class="btn btn-dark border border-secondary rounded-pill d-flex align-items-center gap-2 p-1 pe-3 shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="badge bg-warning text-dark rounded-circle p-2">AD</span>
                                <span class="fw-semibold small text-white">Quản Trị Viên</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li><a class="dropdown-item small" href="/Admin/Settings">Cài Đặt Hệ Thống</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small text-danger fw-semibold" href="/Admin/Account/Logout">Đăng Xuất Quản Trị</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-5 pt-3 page-transition-container">
        @RenderBody()
    </main>

    <footer class="admin-footer">
        <div class="container text-center">
            <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
                <span class="fw-bold text-white">DONET ACADEMY — HỆ THỐNG QUẢN TRỊ TRUNG TÂM</span>
            </div>
            <p class="small text-secondary mb-0">
                &copy; 2026 DONET Academy. Khu vực dành riêng cho Ban Giám Hiệu & Quản Trị Viên Kỹ Thuật.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

