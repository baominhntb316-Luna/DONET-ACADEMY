@model List<DONET_Academy.Core.Entities.HoSoGiaoVien>
@{
    ViewData["Title"] = "Phê Duyệt Hồ Sơ Giáo Viên";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Kiểm Duyệt Hồ Sơ Giáo Viên & Gia Sư</h2>
            <p class="text-muted mb-0">Xác minh bằng cấp, chứng chỉ sư phạm trước khi cho phép giáo viên mở ca dạy trên sàn</p>
        </div>
    </div>

    <!-- Verification Table -->
    <div class="card-donet">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>MÃ GV</th>
                        <th>HỌ VÀ TÊN</th>
                        <th>CHUYÊN MÔN</th>
                        <th>BẰNG CẤP & CHỨNG CHỈ</th>
                        <th>KINH NGHIỆM</th>
                        <th>TRẠNG THÁI</th>
                        <th>THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var gv in Model)
                    {
                        <tr>
                            <td>#GV-@gv.MaHoSoGiaoVien</td>
                            <td><strong>@gv.NguoiDung?.HoTen</strong></td>
                            <td>
                                @foreach (var m in gv.GiaoVien_MonHocs)
                                {
                                    <span class="badge bg-light text-dark border">@m.MonHoc?.TenMonHoc</span>
                                }
                            </td>
                            <td>@gv.BangCapChungChi</td>
                            <td>@gv.SoNamKinhNghiem năm</td>
                            <td>
                                @if (gv.TrangThaiDuyet == DONET_Academy.Core.Enums.TrangThaiHoSoGiaoVien.DaDuyet)
                                {
                                    <span class="badge bg-success">Đã duyệt</span>
                                }
                                else if (gv.TrangThaiDuyet == DONET_Academy.Core.Enums.TrangThaiHoSoGiaoVien.ChoDuyet)
                                {
                                    <span class="badge bg-warning text-dark">Chờ xét duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Từ chối</span>
                                }
                            </td>
                            <td>
                                <button onclick="openModal('verifyModal')" class="btn-donet py-1 px-3 small">Xem & Phê Duyệt</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Teacher Verification Modal (Chuẩn Bootstrap 5 & Apple Design) -->
<div class="modal fade modal-apple-blur" id="verifyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; padding: 28px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%); border: 1.5px solid #FCD34D;">
                        <span class="fs-5">📋</span>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Hồ Sơ Giáo Viên: ThS. Nguyễn Văn Bình</h4>
                        <p class="text-muted small mb-0">Kiểm tra văn bằng chứng chỉ và xét duyệt quyền mở lớp dạy 1-1</p>
                    </div>
                </div>
                <button type="button" class="btn-close-apple" data-bs-dismiss="modal" onclick="closeModal('verifyModal')">✕</button>
            </div>
            
            <div class="mb-3">
                <div class="small text-muted">Chuyên môn: <strong class="text-dark">Sư phạm Toán THPT (Lớp 10, 11, 12)</strong></div>
                <div class="small text-muted mt-1">Bằng cấp: <strong class="text-dark">Thạc sĩ ĐH Sư Phạm TP.HCM, Chứng chỉ Nghiệp vụ Sư phạm Cao cấp</strong></div>
            </div>

            <div class="p-3 bg-light rounded-3 mb-3 border d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span>📄</span>
                    <span class="fw-semibold small">CV_ChungChi_Toan.pdf</span>
                </div>
                <button type="button" onclick="showToast('Đang mở file hồ sơ chứng chỉ đính kèm...', 'info')" class="btn-outline-donet py-1 px-3 small">Tải xem</button>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold">Nhập lý do phê duyệt hoặc từ chối hồ sơ:</label>
                <textarea class="form-control input-apple" rows="3" placeholder="Ghi chú phản hồi cho giáo viên..."></textarea>
            </div>

            <div class="d-flex gap-2 pt-2 border-top">
                <button type="button" data-bs-dismiss="modal" onclick="closeModal('verifyModal')" class="btn-outline-donet flex-grow-1">Hủy</button>
                <button type="button" onclick="closeModal('verifyModal'); showToast('Đã từ chối hồ sơ giáo viên kèm lý do.', 'warning')" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold" style="box-shadow: 0 4px 14px rgba(239, 68, 68, 0.25);">Từ Chối (Reject)</button>
                <button type="button" onclick="closeModal('verifyModal'); showToast('Đã phê duyệt hồ sơ giáo viên thành công! Tài khoản được mở ca dạy.', 'success')" class="btn btn-donet-gold flex-grow-1 py-2 fw-bold shadow-sm">Phê Duyệt (Approve)</button>
            </div>
        </div>
    </div>
</div>

