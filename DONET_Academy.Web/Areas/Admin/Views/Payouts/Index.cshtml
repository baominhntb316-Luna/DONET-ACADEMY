@model List<DONET_Academy.Core.Entities.LenhRutTien>
@{
    ViewData["Title"] = "Duyệt Lệnh Rút Tiền";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Duyệt Lệnh Rút Tiền Thu Nhập Của Giáo Viên</h2>
            <p class="text-muted mb-0">Đối soát thông tin tài khoản ngân hàng và xác nhận lệnh chuyển tiền</p>
        </div>
    </div>

    <div class="card-donet">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>MÃ LỆNH</th>
                        <th>GIÁO VIÊN</th>
                        <th>SỐ TIỀN RÚT</th>
                        <th>THÔNG TIN TÀI KHOẢN NGÂN HÀNG</th>
                        <th>NGÀY YÊU CẦU</th>
                        <th>TRẠNG THÁI</th>
                        <th>THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>#RT-@p.MaLenhRut</td>
                            <td><strong>@p.HoSoGiaoVien?.NguoiDung?.HoTen</strong></td>
                            <td class="fw-bold text-danger">@p.SoTien.ToString("N0") đ</td>
                            <td>
                                <div><strong>@p.TaiKhoanNhanTien?.TenNganHang</strong> — @p.TaiKhoanNhanTien?.SoTaiKhoan</div>
                                <span class="text-muted small">Chủ TK: @p.TaiKhoanNhanTien?.TenChuTaiKhoan (CN: @p.TaiKhoanNhanTien?.ChiNhanh)</span>
                            </td>
                            <td class="small text-muted">@p.NgayYeuCau.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge bg-warning text-dark">Chờ chuyển tiền</span>
                            </td>
                            <td>
                                <button onclick="showToast('Xác nhận đã chuyển khoản thành công cho giáo viên #RT-@p.MaLenhRut', 'success')" class="btn-donet py-1 px-3 small">Xác Nhận Đã Chuyển</button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Hiện tại không có lệnh rút tiền nào đang chờ xử lý.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

