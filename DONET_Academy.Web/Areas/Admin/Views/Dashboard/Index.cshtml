                    <a href="/Admin/Payouts" class="btn-outline-donet justify-content-start py-2">Duyệt Lệnh Rút Tiền Thu Nhập</a>
                    <a href="/Admin/Settings" class="btn-outline-donet justify-content-start py-2">Cấu Hình Hoa Hồng & Hủy Lịch</a>
                </div>
            </div>

            <div class="card-donet">
                <h5 class="fw-bold mb-2">Trạng Thái Kỹ Thuật</h5>
                <div class="small text-muted mb-1">&bull; Nền tảng: ASP.NET Core MVC Layered Monolith</div>
                <div class="small text-muted mb-1">&bull; Database: EF Core Code First (SQL Server Ready)</div>
                <div class="small text-muted">&bull; Chế độ: InMemory Demo Seeder 55 thực thể</div>
            </div>
