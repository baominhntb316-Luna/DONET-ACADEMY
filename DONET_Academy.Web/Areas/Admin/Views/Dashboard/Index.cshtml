        </div>
    </div>

    <!-- Stats KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card-donet">
                <span class="text-muted small fw-semibold">TỔNG HỌC SINH THPT</span>
                <div class="h2 fw-bold text-dark mt-2 mb-1">262</div>
                <div class="small text-success">+18 học sinh tuần này</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-donet">
                <span class="text-muted small fw-semibold">GIÁO VIÊN / GIA SƯ</span>
