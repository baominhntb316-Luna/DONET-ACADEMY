@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị Hệ Thống";
    var totalUsers = ViewBag.TotalUsers ?? 3;
    var totalStudents = ViewBag.TotalStudents ?? 1;
    var totalTeachers = ViewBag.TotalTeachers ?? 1;
    var reports = ViewBag.Reports as List<DONET_Academy.Core.Entities.BaoCaoDoanhThuAdmin> ?? new();
}

