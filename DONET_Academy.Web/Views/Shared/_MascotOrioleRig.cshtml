@* Model 2D SVG Rigging: Bé Chim Hoàng Anh Chibi Anime Chuyển Động Thật Sự *@
@{
    var size = ViewData["Size"]?.ToString() ?? "header"; // "header" (44px) hoặc "hero" (240px)
    var isHero = size == "hero";
    var svgClass = isHero ? "oriole-rig-hero" : "oriole-rig-header";
}

<div class="oriole-rig-container @svgClass" data-rig-size="@size">
    <svg viewBox="0 0 200 220" class="oriole-svg-canvas" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <!-- Gradients cho cơ thể và đôi cánh -->
            <radialGradient id="bodyGrad" cx="45%" cy="40%" r="60%">
                <stop offset="0%" stop-color="#FEF08A" />
                <stop offset="45%" stop-color="#FBBF24" />
                <stop offset="85%" stop-color="#F59E0B" />
                <stop offset="100%" stop-color="#D97706" />
            </radialGradient>
            
            <linearGradient id="bellyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#FFFBEB" />
                <stop offset="100%" stop-color="#FEF3C7" />
            </linearGradient>

            <linearGradient id="wingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FBBF24" />
                <stop offset="60%" stop-color="#F59E0B" />
                <stop offset="100%" stop-color="#D97706" />
            </linearGradient>

            <linearGradient id="capGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#334155" />
                <stop offset="100%" stop-color="#0F172A" />
            </linearGradient>

            <!-- Bộ lọc đổ bóng nhẹ tự nhiên -->
            <filter id="orioleShadow" x="-10%" y="-10%" width="120%" height="130%">
                <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#B45309" flood-opacity="0.25" />
            </filter>
        </defs>

        <!-- BÓNG ĐỔ DƯỚI ĐẤT KHI NHÚN NHẢY -->
        <ellipse cx="100" cy="208" rx="46" ry="7" fill="#000000" opacity="0.12" class="oriole-ground-shadow" />

        <!-- ĐÔI CHÂN CAM NHÚN NHẢY -->
        <g class="oriole-feet">
            <ellipse cx="82" cy="200" rx="11" ry="5" fill="#EA580C" />
            <ellipse cx="118" cy="200" rx="11" ry="5" fill="#EA580C" />
        </g>

        <!-- KHỐI THÂN CHÍNH (SQUASH & STRETCH RIG) -->
        <g class="oriole-body-group" filter="url(#orioleShadow)">
            <!-- Thân chim mập mạp hình quả lê tròn -->
            <path d="M 100,55 
                     C 145,55 168,90 168,135 
                     C 168,175 140,202 100,202 
                     C 60,202 32,175 32,135 
                     C 32,90 55,55 100,55 Z" 
                  fill="url(#bodyGrad)" />

            <!-- Bụng trắng kem bầu bĩnh -->
            <ellipse cx="100" cy="148" rx="44" ry="40" fill="url(#bellyGrad)" />

            <!-- Má hồng đào dễ thương -->
            <ellipse cx="62" cy="128" rx="9" ry="6" fill="#F43F5E" opacity="0.32" />
            <ellipse cx="138" cy="128" rx="9" ry="6" fill="#F43F5E" opacity="0.32" />

            <!-- CÁNH TRÁI (VỖ & VẪY CHÀO ĐỘC LẬP) -->
            <g class="oriole-wing oriole-wing-left">
                <path d="M 44,115 
                         C 18,125 10,152 24,170 
                         C 34,180 52,165 52,148 
                         C 52,132 48,120 44,115 Z" 
                      fill="url(#wingGrad)" />
            </g>

            <!-- CÁNH PHẢI (CẦM CUỐN SỔ DONET) -->
            <g class="oriole-wing oriole-wing-right">
                <path d="M 156,115 
                         C 182,125 190,152 176,170 
                         C 166,180 148,165 148,148 
                         C 148,132 152,120 156,115 Z" 
                      fill="url(#wingGrad)" />
                
                <!-- Cuốn sổ tri thức xanh của DONET -->
                <g class="oriole-notebook" transform="rotate(-10 162 150)">
                    <rect x="145" y="140" width="22" height="28" rx="3" fill="#2563EB" />
                    <rect x="148" y="143" width="16" height="22" rx="1.5" fill="#EFF6FF" />
                    <!-- Ngôi sao nhỏ trên bìa -->
                    <polygon points="156,150 158,154 162,154 159,157 160,161 156,158 152,161 153,157 150,154 154,154" fill="#F59E0B" />
                </g>
            </g>

            <!-- GƯƠNG MẶT & ĐÔI MẮT ANIME (CHỚP & LIẾC CHUYỂN ĐỘNG THẬT) -->
            <g class="oriole-face">
                <!-- MẮT TRÁI -->
                <g class="oriole-eye oriole-eye-left" transform="translate(74, 110)">
                    <!-- Tròng trắng -->
                    <ellipse cx="0" cy="0" rx="12" ry="16" fill="#FFFFFF" />
                    <!-- Con ngươi đen có thể liếc nhìn -->
                    <g class="oriole-pupil">
                        <ellipse cx="0" cy="0" rx="9" ry="13" fill="#1C1917" />
                        <!-- Điểm sáng lấp lánh (Sparkle Highlights) -->
                        <circle cx="-3" cy="-5" r="3.5" fill="#FFFFFF" />
                        <circle cx="3" cy="4" r="1.5" fill="#FFFFFF" />
                    </g>
                    <!-- Mí mắt chớp chuyển động -->
                    <path class="oriole-eyelid" d="M -12,-16 Q 0,-18 12,-16 L 12,-16 Q 0,-18 -12,-16 Z" fill="#F59E0B" />
                </g>

                <!-- MẮT PHẢI -->
                <g class="oriole-eye oriole-eye-right" transform="translate(126, 110)">
                    <!-- Tròng trắng -->
                    <ellipse cx="0" cy="0" rx="12" ry="16" fill="#FFFFFF" />
                    <!-- Con ngươi đen có thể liếc nhìn -->
                    <g class="oriole-pupil">
                        <ellipse cx="0" cy="0" rx="9" ry="13" fill="#1C1917" />
                        <!-- Điểm sáng lấp lánh -->
                        <circle cx="-3" cy="-5" r="3.5" fill="#FFFFFF" />
                        <circle cx="3" cy="4" r="1.5" fill="#FFFFFF" />
                    </g>
                    <!-- Mí mắt chớp chuyển động -->
                    <path class="oriole-eyelid" d="M -12,-16 Q 0,-18 12,-16 L 12,-16 Q 0,-18 -12,-16 Z" fill="#F59E0B" />
                </g>

                <!-- CHIẾC MỎ CAM CUTE (MẤP MÁY KHI NÓI / CƯỜI) -->
                <g class="oriole-beak-group" transform="translate(100, 126)">
                    <!-- Mỏ trên -->
                    <path d="M -10,0 C -5,-4 5,-4 10,0 C 8,7 0,11 -10,0 Z" fill="#EA580C" />
                    <!-- Mỏ dưới / Miệng cười hé -->
                    <path class="oriole-mouth" d="M -6,2 C -3,7 3,7 6,2 Z" fill="#BE123C" opacity="0.85" />
                    <!-- Highlight sống mũi mỏ -->
                    <path d="M -4,-1 Q 0,-3 4,-1" stroke="#FDBA74" stroke-width="1" fill="none" />
                </g>
            </g>

            <!-- MŨ CỬ NHÂN TỐT NGHIỆP TRÊN ĐẦU (GẬT GÙ THEO ĐẦU) -->
            <g class="oriole-mortarboard" transform="translate(100, 48)">
                <!-- Đỉnh mũ hình thoi nghiêng nhẹ -->
                <polygon points="0,-18 52,-4 0,10 -52,-4" fill="url(#capGrad)" />
                <!-- Đai mũ tròn -->
                <path d="M -24,-2 C -24,9 24,9 24,-2 L 20,-8 L -20,-8 Z" fill="#1E293B" />
                <!-- Nút đỉnh mũ -->
                <circle cx="0" cy="-4" r="3" fill="#FBBF24" />
                <!-- Dây tua rua vàng đung đưa -->
                <g class="oriole-tassel">
                    <path d="M 0,-4 C 18,-6 28,6 26,22" stroke="#FBBF24" stroke-width="2" fill="none" stroke-linecap="round" />
                    <circle cx="26" cy="24" r="2.5" fill="#F59E0B" />
                </g>
            </g>
        </g>
    </svg>
</div>

